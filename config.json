{
  "mcpServers": {
    "HackerNews": {
      "args": [
        "mcp-hn"
      ],
      "command": "uvx",
      "type": "STDIO"
    },
    "airbnb": {
      "args": [
        "-y",
        "@openbnb/mcp-server-airbnb"
      ],
      "command": "npx"
    },
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "command": "npx"
    }
  },
  "settings": {
    "apiKey": "",
    "httpHost": "localhost",
    "httpPort": 3000,
    "maxSnapshotLogLines": 500,
    "model": "claude-sonnet-4-6",
    "transport": "stdio",
    "uiPort": 0
  }
}